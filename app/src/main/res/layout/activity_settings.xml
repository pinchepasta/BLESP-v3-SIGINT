<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/headerSettings"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical"
        android:background="#0F0F0F"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvSettingsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONFIGURATION."
            android:fontFamily="monospace"
            android:textColor="#00FF41"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerSettings"
        app:layout_constraintBottom_toTopOf="@id/btnSettingsBack">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvLabelTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIVE VISUAL PROTOCOL"
                android:fontFamily="monospace"
                android:textColor="#00FF41"
                android:textSize="12sp"
                android:layout_marginBottom="16dp"
                android:alpha="0.7" />

            <!-- Dropdown for Theme Selection -->
            <Spinner
                android:id="@+id/spTheme"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/status_box_bg"
                android:padding="8dp"
                android:spinnerMode="dropdown" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#222222"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="32dp" />

            <TextView
                android:id="@+id/tvLabelHud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HUD PARAMETERS"
                android:fontFamily="monospace"
                android:textColor="#00FF41"
                android:textSize="12sp"
                android:layout_marginBottom="16dp"
                android:alpha="0.7" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="@drawable/status_box_bg">

                <TextView
                    android:id="@+id/tvImmersiveText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="IMMERSIVE OVERLAY"
                    android:textColor="#00FF41"
                    android:fontFamily="monospace"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/swImmersive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#00FF41"
                    android:trackTint="#3300FF41" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="FORCE FULLSCREEN TACTICAL OVERLAY."
                android:textColor="#4400FF41"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <LinearLayout
                android:id="@+id/layoutSecretAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="32dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/status_box_bg">

                <TextView
                    android:id="@+id/tvSecretAudioLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SECRET AUDIO"
                    android:fontFamily="monospace"
                    android:textColor="#00FF41"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"
                    android:alpha="0.8" />

                <TextView
                    android:id="@+id/tvSecretAudioCommands"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="START CODE: 77872\nSTOP  CODE: 77873"
                    android:textColor="#00FF41"
                    android:fontFamily="monospace"
                    android:textSize="15sp"
                    android:lineSpacingExtra="6dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tvSecretAudioPath"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PATH: /Download/BLESP"
                    android:textColor="#4400FF41"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.05" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnSettingsBack"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/status_box_bg_pink"
        android:fontFamily="monospace"
        android:minWidth="80dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:text="CLOSE"
        android:textColor="#FF00FF"
        android:textSize="12sp"
        style="?attr/borderlessButtonStyle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
