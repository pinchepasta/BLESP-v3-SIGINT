<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnBack">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/tvTitle"
                android:text="TARGET ACQUIRED"
                android:textColor="#00FF41"
                android:textSize="20sp"
                android:fontFamily="monospace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvType"
            android:text="▸ TYPE    : ---"
            android:textColor="#00FF41"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvName"
            android:text="▸ NAME    : ---"
            android:textColor="#00FF41"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#003B0F"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvAddress"
            android:text="▸ ADDRESS : ---"
            android:textColor="#00AA2A"
            android:textSize="15sp"
            android:fontFamily="monospace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvRssi"
            android:text="▸ RSSI    : ---"
            android:textColor="#00AA2A"
            android:textSize="15sp"
            android:fontFamily="monospace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvDist"
            android:text="▸ DIST    : ---"
            android:textColor="#00AA2A"
            android:textSize="22sp"
            android:fontFamily="monospace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/id_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnAlarm"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="► 01 ALARM: OFF"
            android:fontFamily="monospace"
            android:textColor="#00FF41"
            android:textSize="14sp"
            android:background="@drawable/btn_bg_dim"
            android:layout_marginBottom="8dp"
            style="?attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/btnSound"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="► 02 SOUND: ON"
            android:fontFamily="monospace"
            android:textColor="#00FF41"
            android:textSize="14sp"
            android:background="@drawable/btn_bg_dim"
            android:layout_marginBottom="8dp"
            style="?attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/btnBeepAirTag"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="► 03 TRIGGER BEEP"
            android:fontFamily="monospace"
            android:textColor="#FF00FF"
            android:textSize="14sp"
            android:background="@drawable/btn_bg_dim"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            style="?attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/btnEsl"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="► 04 ESL TAG TOOLS"
            android:fontFamily="monospace"
            android:textColor="#40E0D0"
            android:textSize="14sp"
            android:background="@drawable/btn_bg_dim"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            style="?attr/borderlessButtonStyle" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#003B0F"
            android:layout_marginBottom="12dp"/>


        <TextView
            android:id="@+id/tvExtra1"
            android:text="▸ ---"
            android:textColor="#00AA2A"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvExtra2"
            android:text="▸ ---"
            android:textColor="#00AA2A"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvExtra3"
            android:text="▸ ---"
            android:textColor="#00AA2A"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvExtra4"
            android:text="▸ ---"
            android:textColor="#00AA2A"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvFastPair"
            android:text="▸ FAST PAIR: NO"
            android:textColor="#00AA2A"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvSelectExploitLabel"
            android:text="▸ SELECT EXPLOIT:"
            android:textColor="#00FF41"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spExploits"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/btn_bg_dim"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvExploitDesc"
            android:text="Select an exploit to view technical details..."
            android:textColor="#888888"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:padding="8dp"
            android:background="#1AFFFFFF" />

        <TextView
            android:id="@+id/tvExtra5"
            android:text="▸ ---"
            android:textColor="#00AA2A"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvExtra6"
            android:text="▸ ---"
            android:textColor="#00AA2A"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/status_box_bg_pink"
        android:fontFamily="monospace"
        android:minWidth="80dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:text="CLOSE"
        android:textColor="#FF00FF"
        android:textSize="12sp"
        style="?attr/borderlessButtonStyle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
