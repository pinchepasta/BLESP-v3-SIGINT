<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/aboutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/headerAbout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical"
        android:background="#0F0F0F"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvAboutTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WHAT DOES THE APP DO?"
            android:fontFamily="monospace"
            android:textColor="#00FF41"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerAbout"
        app:layout_constraintBottom_toTopOf="@id/btnAboutBack">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvLabelVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CORE VERSION"
                android:fontFamily="monospace"
                android:textColor="#00FF41"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"
                android:alpha="0.7" />

            <TextView
                android:id="@+id/tvVersionValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v3.1.3"
                android:fontFamily="monospace"
                android:textColor="#00FF41"
                android:textSize="16sp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:id="@+id/tvLabelAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUTHOR"
                android:fontFamily="monospace"
                android:textColor="#00FF41"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"
                android:alpha="0.7" />

            <TextView
                android:id="@+id/tvAuthorValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chris Edgar"
                android:fontFamily="monospace"
                android:textColor="#00FF41"
                android:textSize="16sp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:id="@+id/tvLabelDev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEVELOPMENT"
                android:fontFamily="monospace"
                android:textColor="#00FF41"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"
                android:alpha="0.7" />

            <TextView
                android:id="@+id/tvDevValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="www.mostlyawesome.de"
                android:fontFamily="monospace"
                android:textColor="#00FF41"
                android:textSize="16sp"
                android:layout_marginBottom="24dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#222222"
                android:layout_marginBottom="24dp" />

            <TextView
                android:id="@+id/tvAboutDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Designed for passive and active signal intelligence and mapping operations.\n\nAll signals processed locally. No data transmitted to cloud services without explicit user command."
                android:textColor="#8800FF41"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnAboutBack"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginBottom="56dp"
        android:background="@drawable/status_box_bg"
        android:fontFamily="monospace"
        android:minWidth="100dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="BACK"
        android:textColor="#00FF41"
        android:textSize="12sp"
        style="?attr/borderlessButtonStyle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
