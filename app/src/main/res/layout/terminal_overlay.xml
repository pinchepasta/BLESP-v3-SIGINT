<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:id="@+id/terminalRoot"
    android:fitsSystemWindows="true">

    <!-- SSH LOGIN PAGE -->
    <LinearLayout
        android:id="@+id/sshLoginPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#000000"
        android:visibility="visible">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:isScrollContainer="true">

            <LinearLayout
                android:id="@+id/connectionLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvSshLoginTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/terminal_title"
                    android:textColor="#00FF41"
                    android:fontFamily="monospace"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:paddingBottom="20dp" />

                <AutoCompleteTextView
                    android:id="@+id/etHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#004400"
                    android:hint="@string/terminal_host_hint"
                    android:background="#111111"
                    android:fontFamily="monospace"
                    android:textSize="16sp"
                    android:padding="8dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:inputType="textUri"
                    android:imeOptions="actionNext" />

                <EditText
                    android:id="@+id/etUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#004400"
                    android:hint="@string/terminal_user_hint"
                    android:background="#111111"
                    android:fontFamily="monospace"
                    android:textSize="16sp"
                    android:padding="8dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:inputType="textPersonName"
                    android:imeOptions="actionNext" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#004400"
                    android:hint="@string/terminal_pass_hint"
                    android:background="#111111"
                    android:fontFamily="monospace"
                    android:textSize="16sp"
                    android:padding="8dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:inputType="textPassword"
                    android:imeOptions="actionNext" />

                <Spinner
                    android:id="@+id/spKeyFile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="#111111"
                    android:padding="8dp"
                    android:minHeight="40dp" />

                <Button
                    android:id="@+id/btnConnect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:text="@string/terminal_btn_connect"
                    android:fontFamily="monospace"
                    android:textColor="#000000"
                    android:backgroundTint="#00FF41"
                    android:textSize="16sp"
                    android:padding="12dp" />

                <Button
                    android:id="@+id/btnSshLoginClose"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_close"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:textColor="#FF00FF"
                    android:background="@android:color/transparent"
                    android:textSize="14sp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:visibility="visible"
                    style="?attr/borderlessButtonStyle" />



            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- SSH TERMINAL PAGE -->
    <LinearLayout
        android:id="@+id/sshTerminalPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/headerSshTerminal"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center_vertical"
            android:background="#0F0F0F"
            android:visibility="gone">

            <Button
                android:id="@+id/btnSshTerminalClose"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:minWidth="40dp"
                android:minHeight="0dp"
                android:text="@string/btn_close"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textColor="#FF00FF"
                android:textSize="9sp"
                android:background="@drawable/status_box_bg_pink"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                style="?attr/borderlessButtonStyle" />

            <Button
                android:id="@+id/btnSshLogout"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:minWidth="40dp"
                android:minHeight="0dp"
                android:text="@string/terminal_btn_logout"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textColor="#FF0000"
                android:textSize="9sp"
                android:background="@drawable/status_box_bg_red"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                style="?attr/borderlessButtonStyle" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/terminalLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:background="#000000">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000">

                <ScrollView
                    android:id="@+id/svTerminal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:isScrollContainer="true"
                    android:scrollbars="vertical"
                    android:overScrollMode="never">
                    <TextView
                        android:id="@+id/tvTerminalOutput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#00FF41"
                        android:fontFamily="monospace"
                        android:typeface="monospace"
                        android:textSize="8sp"
                        android:letterSpacing="0"
                        android:lineSpacingExtra="0dp"
                        android:lineSpacingMultiplier="1.0"
                        android:includeFontPadding="false"
                        android:padding="0dp"
                        android:background="#000000"
                        android:clickable="false"
                        android:focusable="false"
                        android:breakStrategy="simple"
                        android:hyphenationFrequency="none"
                        android:ellipsize="none"
                        android:gravity="top|start" />
                </ScrollView>

                <!-- Hidden but focused EditText for capturing input - Full surface proxy -->
                <EditText
                    android:id="@+id/etCommand"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:textColor="@android:color/transparent"
                    android:cursorVisible="false"
                    android:inputType="textNoSuggestions|textVisiblePassword"
                    android:imeOptions="actionNone"
                    android:importantForAutofill="no"
                    android:gravity="top|start"
                    android:padding="0dp" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
