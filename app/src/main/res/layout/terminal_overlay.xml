<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:id="@+id/terminalRoot"
    android:fitsSystemWindows="true">

    <!-- SSH LOGIN PAGE -->
    <LinearLayout
        android:id="@+id/sshLoginPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#000000"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/headerSshLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="0dp"
            android:gravity="center_vertical"
            android:background="#0F0F0F"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivLogoSshLogin"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/blesp_logo"
                android:scaleType="centerInside"
                android:contentDescription="BLESP Logo" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:isScrollContainer="true">

            <LinearLayout
                android:id="@+id/connectionLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvSshLoginTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SSH LOGIN"
                    android:textColor="#00FF41"
                    android:fontFamily="monospace"
                    android:textSize="24sp"
                    android:gravity="center"
                    android:paddingBottom="30dp" />

                <AutoCompleteTextView
                    android:id="@+id/etHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#004400"
                    android:hint="REMOTE HOST"
                    android:background="#111111"
                    android:fontFamily="monospace"
                    android:textSize="18sp"
                    android:padding="10dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:inputType="textUri"
                    android:imeOptions="actionNext" />

                <EditText
                    android:id="@+id/etUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#004400"
                    android:hint="USER"
                    android:background="#111111"
                    android:fontFamily="monospace"
                    android:textSize="18sp"
                    android:padding="10dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:inputType="textPersonName"
                    android:imeOptions="actionNext" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#004400"
                    android:hint="PASSWORD"
                    android:background="#111111"
                    android:fontFamily="monospace"
                    android:textSize="18sp"
                    android:padding="10dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone" />

                <Button
                    android:id="@+id/btnConnect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:text="INITIATE UPLINK"
                    android:fontFamily="monospace"
                    android:textColor="#000000"
                    android:backgroundTint="#00FF41"
                    android:textSize="18sp"
                    android:padding="20dp" />

                <Button
                    android:id="@+id/btnSshLoginBack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="ABORT"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:textColor="#FF00FF"
                    android:background="@android:color/transparent"
                    android:textSize="16sp"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp"
                    android:visibility="visible"
                    style="?attr/borderlessButtonStyle" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- SSH TERMINAL PAGE -->
    <LinearLayout
        android:id="@+id/sshTerminalPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/headerSshTerminal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical"
            android:background="#0F0F0F">

            <Button
                android:id="@+id/btnSshTerminalBack"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="60dp"
                android:text="BACK"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textColor="#FF00FF"
                android:textSize="12sp"
                android:background="@drawable/status_box_bg_pink"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                style="?attr/borderlessButtonStyle" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/terminalLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="4dp"
            android:background="?android:attr/windowBackground">

            <ScrollView
                android:id="@+id/svTerminal"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/status_box_bg"
                android:padding="8dp"
                android:fillViewport="true"
                android:isScrollContainer="true">
                <TextView
                    android:id="@+id/tvTerminalOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#00FF41"
                    android:fontFamily="monospace"
                    android:textSize="11sp" />
            </ScrollView>

            <LinearLayout
                android:id="@+id/terminalControlsRoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp"
                android:background="#0F0F0F"
                android:padding="4dp">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="4dp">
                        <Button android:id="@+id/btnCtrl" android:layout_width="42dp" android:layout_height="40dp" android:text="^" android:textColor="#00FF41" android:background="@drawable/btn_bg_dim" style="?attr/borderlessButtonStyle" />
                        <Button android:id="@+id/btnTab" android:layout_width="48dp" android:layout_height="40dp" android:text="TAB" android:textSize="9sp" android:textColor="#00FF41" android:background="@drawable/btn_bg_dim" android:layout_marginStart="2dp" style="?attr/borderlessButtonStyle" />
                        <Button android:id="@+id/btnCtrlC" android:layout_width="42dp" android:layout_height="40dp" android:text="^C" android:textSize="9sp" android:textColor="#00FF41" android:background="@drawable/btn_bg_dim" android:layout_marginStart="2dp" style="?attr/borderlessButtonStyle" />
                        <Button android:id="@+id/btnLeft" android:layout_width="42dp" android:layout_height="40dp" android:text="&lt;" android:textColor="#00FF41" android:background="@drawable/btn_bg_dim" android:layout_marginStart="8dp" style="?attr/borderlessButtonStyle" />
                        <Button android:id="@+id/btnUp" android:layout_width="42dp" android:layout_height="40dp" android:text="^" android:textColor="#00FF41" android:background="@drawable/btn_bg_dim" android:layout_marginStart="2dp" style="?attr/borderlessButtonStyle" />
                        <Button android:id="@+id/btnDown" android:layout_width="42dp" android:layout_height="40dp" android:text="v" android:textColor="#00FF41" android:background="@drawable/btn_bg_dim" android:layout_marginStart="2dp" style="?attr/borderlessButtonStyle" />
                        <Button android:id="@+id/btnRight" android:layout_width="42dp" android:layout_height="40dp" android:text="&gt;" android:textColor="#00FF41" android:background="@drawable/btn_bg_dim" android:layout_marginStart="2dp" style="?attr/borderlessButtonStyle" />
                    </LinearLayout>
                </HorizontalScrollView>

                <EditText
                    android:id="@+id/etCommand"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="[ ENTER COMMAND... ]"
                    android:textColor="#00FF41"
                    android:textColorHint="#004400"
                    android:fontFamily="monospace"
                    android:background="@drawable/btn_bg_dim"
                    android:paddingStart="12dp"
                    android:textSize="13sp"
                    android:imeOptions="actionSend"
                    android:inputType="textNoSuggestions"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
