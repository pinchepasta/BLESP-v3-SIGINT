<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CalculatorButton.Base" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">36dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Calculator.Button</item>
    </style>

    <style name="CalculatorButton.Number" parent="CalculatorButton.Base">
        <item name="backgroundTint">#1A1A1A</item>
        <item name="android:textColor">#00FF41</item>
        <item name="rippleColor">#3300FF41</item>
    </style>

    <style name="CalculatorButton.Operator" parent="CalculatorButton.Base">
        <item name="backgroundTint">#333333</item>
        <item name="android:textColor">#00FF41</item>
        <item name="rippleColor">#3300FF41</item>
    </style>

    <style name="CalculatorButton.Action" parent="CalculatorButton.Base">
        <item name="backgroundTint">#003B0F</item>
        <item name="android:textColor">#00FF41</item>
        <item name="rippleColor">#3300FF41</item>
    </style>

    <style name="CalculatorButton.Equal" parent="CalculatorButton.Base">
        <item name="backgroundTint">#FF00FF</item>
        <item name="android:textColor">#000000</item>
        <item name="rippleColor">#40000000</item>
    </style>

    <style name="ShapeAppearance.Calculator.Button" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
