<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent">#39FF14</color>
    <color name="accent_hi">#9DFF7A</color>
    <color name="accent_ink">#011006</color>
    <color name="bg">#030304</color>
    <color name="line">#14351F</color>
    <color name="line_bright">#1FAE5C</color>
    <color name="muted">#4FAE7C</color>
    <color name="panel">#0A0F0C</color>
    <color name="panel_strong">#0F1712</color>
    <color name="pink">#FF2BD6</color>
    <color name="text">#E8FFF1</color>
    <color name="text_dim">#A9F5C9</color>
    <color name="white">#FFFFFF</color>
    <string name="app_name">NODE8</string>
    <string name="tab_receive">Receive</string>
    <string name="tab_send">Send</string>
    <style name="Node8"/>
    <style name="Node8.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/accent_ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Node8.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/line_bright</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <style name="Node8.Hint">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <style name="Node8.Label">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <style name="Node8.TabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabIndicatorColor">@color/accent</item>
        <item name="tabSelectedTextColor">@color/accent</item>
        <item name="tabTextColor">@color/muted</item>
        <item name="android:background">@color/panel</item>
    </style>
    <style name="Theme.Node8" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="tabStyle">@style/Node8.TabLayout</item>
    </style>
</resources>