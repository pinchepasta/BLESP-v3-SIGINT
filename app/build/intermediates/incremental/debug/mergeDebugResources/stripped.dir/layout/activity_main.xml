<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Header bar -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0A0A0A"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="0dp"
            android:gravity="center_vertical"
            android:background="#0F0F0F">

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="1dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/blesp_logo"
                android:scaleType="centerInside"
                android:contentDescription="BLESP Logo" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnInfo"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="-2dp"
                android:src="@drawable/ic_help"
                android:contentDescription="About App"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="2dp" />

            <ImageView
                android:id="@+id/btnGlobeListTop"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="-2dp"
                android:src="@drawable/ic_file"
                android:contentDescription="Toggle List View"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="2dp" />

            <ImageView
                android:id="@+id/btnKillswitch"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="61dp"
                android:layout_marginTop="-2dp"
                android:src="@drawable/ic_lock"
                android:contentDescription="Killswitch"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="2dp"
                android:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:text="STANDBY"
            android:textColor="#00FF41"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/status_box_bg"
            android:gravity="center"
            android:maxLines="1"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeMaxTextSize="13sp"
            app:autoSizeStepGranularity="1sp" />
    </LinearLayout>

    <!-- Radar View -->
    <FrameLayout
        android:id="@+id/radarContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        app:layout_constraintBottom_toTopOf="@id/infoContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.radar.blewifi.RadarView
            android:id="@+id/radarView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tvOverlayNetworkName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:text="NETWORK NAME"
            android:textColor="#00FF41"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:visibility="gone"
            android:shadowColor="#FF00FF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="2" />
    </FrameLayout>

    <!-- Info bar (Coordinates and Timecode) -->
    <LinearLayout
        android:id="@+id/infoContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@android:color/transparent"
        android:layout_marginBottom="95dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvCoordinates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LAT: 0.000000 LON: 0.000000"
            android:textColor="#00FF41"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:background="#44000000"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:alpha="0.8" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp">

            <com.radar.blewifi.MiniGraphView
                android:id="@+id/miniGraph"
                android:layout_width="80dp"
                android:layout_height="30dp"
                android:layout_marginEnd="8dp" />

            <com.radar.blewifi.MiniGraphView
                android:id="@+id/netGraph"
                android:layout_width="80dp"
                android:layout_height="30dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTimecode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="00:00:00:000"
            android:textColor="#00FF41"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:background="#44000000"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:alpha="0.8" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <ImageView
                android:id="@+id/btnThemeToggle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_theme_toggle"
                android:contentDescription="Toggle Theme"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:layout_marginEnd="16dp" />

            <ImageView
                android:id="@+id/btnStats"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_chart"
                android:contentDescription="Statistics"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:layout_marginEnd="16dp" />

            <ImageView
                android:id="@+id/btnArchive"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_archive"
                android:contentDescription="Archive"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:layout_marginEnd="16dp" />

            <ImageView
                android:id="@+id/btnPager"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_pager"
                android:contentDescription="Pager"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:layout_marginEnd="16dp" />

            <ImageView
                android:id="@+id/btnEsl"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_tag"
                android:contentDescription="ESL Tools"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:tint="#00FF41" />
        </LinearLayout>

        <Button
            android:id="@+id/btnBeep"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:text="[ NOISEGENERATOR ]"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="#00FF41"
            android:textSize="10sp"
            android:background="@drawable/status_box_bg_green"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="4dp"
            android:drawableStart="@drawable/ic_speaker"
            android:drawablePadding="4dp"
            android:drawableTint="#00FF41"
            style="?attr/borderlessButtonStyle" />
    </LinearLayout>

    <!-- List View -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="#000000"
        android:padding="8dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        app:layout_constraintBottom_toTopOf="@id/infoContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom controls -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#0A0A0A"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Filters Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:padding="2dp"
            android:background="@drawable/status_box_bg">

            <CheckBox
                android:id="@+id/cbBle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:minHeight="44dp"
                android:text="BLE"
                android:textColor="#00FF41"
                android:checked="true"
                android:fontFamily="monospace"
                android:textSize="10sp"
                android:buttonTint="@android:color/transparent" />

            <CheckBox
                android:id="@+id/cb24"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:minHeight="44dp"
                android:text="2.4G"
                android:textColor="#00FF41"
                android:checked="true"
                android:fontFamily="monospace"
                android:textSize="10sp"
                android:buttonTint="@android:color/transparent" />

            <CheckBox
                android:id="@+id/cb5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:minHeight="44dp"
                android:text="5G"
                android:textColor="#00FF41"
                android:checked="true"
                android:fontFamily="monospace"
                android:textSize="10sp"
                android:buttonTint="@android:color/transparent" />


            <CheckBox
                android:id="@+id/cbAero"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:minHeight="44dp"
                android:text="AERO"
                android:textColor="#00FF41"
                android:checked="true"
                android:fontFamily="monospace"
                android:textSize="10sp"
                android:buttonTint="@android:color/transparent" />

            <CheckBox
                android:id="@+id/cbCams"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:minHeight="44dp"
                android:text="CCTV"
                android:textColor="#00FF41"
                android:checked="true"
                android:fontFamily="monospace"
                android:textSize="10sp"
                android:buttonTint="@android:color/transparent" />

            <CheckBox
                android:id="@+id/cbMap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:minHeight="44dp"
                android:text="MAP"
                android:textColor="#00FF41"
                android:checked="false"
                android:fontFamily="monospace"
                android:textSize="10sp"
                android:buttonTint="@android:color/transparent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnScan"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="[ SCAN ]"
                android:fontFamily="monospace"
                android:textColor="#00FF41"
                android:textSize="11sp"
                android:background="@drawable/btn_bg"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="2dp"
                android:padding="0dp"
                style="?attr/borderlessButtonStyle" />

            <Button
                android:id="@+id/btnExt"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:text="[ EXT ]"
                android:fontFamily="monospace"
                android:textColor="#00FF41"
                android:textSize="11sp"
                android:background="@drawable/btn_bg_dim"
                android:padding="0dp"
                style="?attr/borderlessButtonStyle" />

            <Button
                android:id="@+id/btnTerminal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:text="[ SSH ]"
                android:fontFamily="monospace"
                android:textColor="#00FF41"
                android:textSize="11sp"
                android:background="@drawable/btn_bg_dim"
                android:padding="0dp"
                style="?attr/borderlessButtonStyle" />

            <Button
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="[ CLEAR ]"
                android:fontFamily="monospace"
                android:textColor="#00FF41"
                android:textSize="11sp"
                android:background="@drawable/btn_bg_dim"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="4dp"
                android:padding="0dp"
                style="?attr/borderlessButtonStyle" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
